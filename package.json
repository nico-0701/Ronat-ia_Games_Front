{
  "name": "ronat-ia-games-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cliente Web (e Android, via Capacitor) da plataforma de jogos Ronat-ia Games",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-query": "^5.104.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "node scripts/gen-api.mjs",
    "api:sync": "node scripts/gen-api.mjs --sync",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "icons": "node scripts/make-icons.mjs"
  }
}
