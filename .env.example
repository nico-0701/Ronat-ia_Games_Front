# Copie para .env.local (não versionado) e ajuste.

# Endereço da API. Vazio = mesma origem (em desenvolvimento o Vite faz proxy de /api e /hubs para VITE_DEV_API_TARGET).
VITE_API_URL=

# Só em desenvolvimento: para onde o Vite encaminha /api e /hubs.
VITE_DEV_API_TARGET=http://localhost:5080

# Opcional: versão exibida no rodapé/perfil (o CI pode preencher com o hash do commit).
# VITE_APP_VERSION=0.1.0
